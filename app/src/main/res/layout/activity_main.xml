<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VANTA SCROLL"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Effortless chat navigation"
            android:textColor="#8B95A5"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/masterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Scroll Active"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="20dp"
            android:background="#14141C"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14141C"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="Service Offline"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ACTIVATE SERVICE (one time)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#6B5BFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCROLL SPEED"
            android:textColor="#8B95A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/speedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 ms"
            android:textColor="#6B5BFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="195"
            android:progress="25"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWIPE DISTANCE"
            android:textColor="#8B95A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/lenValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45%"
            android:textColor="#6B5BFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/lenSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60"
            android:progress="45"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIRECTION"
            android:textColor="#8B95A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <RadioGroup
            android:id="@+id/dirGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/dirOlder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Older messages"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingBottom="12dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/dirNewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Newer messages"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="8dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14141C"
            android:padding="20dp"
            android:textColor="#8B95A5"
            android:textSize="13sp"
            android:text="HOW TO USE\n\n1. Activate service once (Android requires this)\n2. Toggle Auto-Scroll from here anytime\n3. Volume Up - start scrolling\n4. Volume Down - stop instantly" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="VANTA SCROLL  v1.1"
            android:textColor="#3A3A52"
            android:textSize="10sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
